# Copy to .env and fill in. See docs/USAGE.md for a full walkthrough.

#  Core
SECRET_KEY=change-me-to-a-random-32-byte-string
DATABASE_URL=sqlite+aiosqlite:///./data/aiflow.db
PUBLIC_BASE_URL=http://localhost:8000
# Local Dev
ADMIN_API_BASE=http://localhost:8000
# Path-based routing (optional). Leave blank for
# the recommended subdomain setup. If set, PUBLIC_BASE_URL above must also
# include the same path prefix.
# ROOT_PATH=/aiflow-api

#  Gemini Live 
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Vertex AI enterprise mode (alternative to GEMINI_API_KEY):
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

#  Twilio (optional, only needed for phone calls) 
TWILIO_ACCOUNT_SID=
# Recommended by Twilio over using the Auth Token for outbound REST calls: a
# Standard API Key can be scoped and revoked independently of the account.
# Console: Account > API keys & auth tokens > Create API key > Standard.
# Leave both blank to fall back to TWILIO_AUTH_TOKEN below.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Always required, even if you set the API Key pair above: Twilio signs
# inbound webhook requests with the Auth Token specifically (never an API
# Key secret), so this is what verifies inbound calls are really from
# Twilio. Console: Account > API keys & auth tokens > Auth Token.
TWILIO_AUTH_TOKEN=

#  Widget
WIDGET_CORS_ORIGINS=["*"]

#  Admin dashboard CORS: unset (the default) reuses WIDGET_CORS_ORIGINS
#  above, today's behavior. Set this to your admin dashboard's real
#  origin(s) to stop the admin API from also accepting the widget's
#  permissive cross-origin policy, e.g.
#  ADMIN_CORS_ORIGINS=["https://admin.client-domain.com"]
ADMIN_CORS_ORIGINS=

#  SSRF protection: webhooks, custom tools, and Orchestrator remote
#  endpoints can't reach private/internal/cloud-metadata addresses by
#  default. List specific hostnames here if an agent legitimately needs to
#  reach one of your own internal systems, e.g. SSRF_ALLOWED_HOSTS=["crm.internal.example.com"]
SSRF_ALLOWED_HOSTS=[]

#  Outbound call queue
MAX_CONCURRENT_OUTBOUND_CALLS=5

#  Email (optional, only needed for the send_email tool / email triggers)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

#  CRM/helpdesk connectors (optional, only needed to let an admin connect
#  Salesforce/HubSpot, see docs/site's CRM connectors guide). Each pair is
#  this deployment's own OAuth2 client identity with that provider (a
#  Salesforce Connected App or a HubSpot app), not a customer's credential,
#  one pair activates the connector for every agent that connects to that
#  provider.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

#  SSO (optional, only needed to let your team sign in via your identity
#  provider instead of an AiFlow-specific password; see docs/site's SSO
#  guide). All five required together once you turn this on.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The admin SPA's own public origin (a separate deployment from this
# backend), where the OIDC callback hands the finished login back to.
ADMIN_DASHBOARD_URL=

#  RAG / knowledge base search (optional, sensible defaults apply)
# EMBEDDING_MODEL=gemini-embedding-2
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5

#  Cross-session call summaries (optional, sensible default applies)
# SUMMARIZATION_MODEL=gemini-3.1-flash-lite

#  Bounded retry for failed outbound dials (optional, default 0 = no retry)
# OUTBOUND_CALL_MAX_RETRIES=0

#  Observability (optional)
# SENTRY_DSN=

#  Rate limiting (optional; generous defaults apply automatically even if unset)
# WIDGET_SESSION_RATE_LIMIT=30/minute
# EVENT_INGESTION_RATE_LIMIT=120/minute

#  Data retention (optional, unset = keep forever, today's exact behavior)
# CALL_TRANSCRIPT_RETENTION_DAYS=
# EVENT_LOG_RETENTION_DAYS=
# OUTBOUND_MESSAGE_RETENTION_DAYS=

#  Postgres overlay (optional; only read if you use docker-compose.postgres.yml,
#  SQLite remains the default otherwise)
# POSTGRES_USER=aiflow
# POSTGRES_PASSWORD=aiflow
# POSTGRES_DB=aiflow

#  Orchestrators (optional, off by default)
# ORCHESTRATORS_ENABLED=false
# Only read for a "provider/model" Orchestrator model string, e.g. "anthropic/claude-sonnet-5"
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Step budget / timeout per Orchestrator run (defaults shown)
# ORCHESTRATOR_MAX_STEPS=25
# ORCHESTRATOR_TASK_TIMEOUT_SECONDS=60
