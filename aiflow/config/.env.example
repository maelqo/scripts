# Copy to .env and fill in. See docs/USAGE.md for a full walkthrough.

#  Core
SECRET_KEY=change-me-to-a-random-32-byte-string
DATABASE_URL=sqlite+aiosqlite:///./data/aiflow.db
PUBLIC_BASE_URL=http://localhost:8000
# Local Dev
ADMIN_API_BASE=http://localhost:8000

#  Gemini Live 
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Vertex AI enterprise mode (alternative to GEMINI_API_KEY):
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

#  Twilio (optional, only needed for phone calls) 
TWILIO_ACCOUNT_SID=
# Recommended by Twilio over using the Auth Token for outbound REST calls: a
# Standard API Key can be scoped and revoked independently of the account.
# Console: Account > API keys & auth tokens > Create API key > Standard.
# Leave both blank to fall back to TWILIO_AUTH_TOKEN below.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Always required, even if you set the API Key pair above: Twilio signs
# inbound webhook requests with the Auth Token specifically (never an API
# Key secret), so this is what verifies inbound calls are really from
# Twilio. Console: Account > API keys & auth tokens > Auth Token.
TWILIO_AUTH_TOKEN=

#  Widget 
WIDGET_CORS_ORIGINS=["*"]

#  Outbound call queue 
MAX_CONCURRENT_OUTBOUND_CALLS=5
