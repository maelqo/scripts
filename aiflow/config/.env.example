# Copy to .env and fill in.

#  Core
SECRET_KEY=change-me-to-a-random-32-byte-string
DATABASE_URL=sqlite+aiosqlite:///./data/aiflow.db
# Where uploaded/imported context documents are stored on disk (optional,
# sensible default applies, only needed to point it at a different mounted
# volume path).
# CONTEXT_DOCS_DIR=./data/context_docs
PUBLIC_BASE_URL=http://localhost:8000
# Local Dev
ADMIN_API_BASE=http://localhost:8000
# Path-based routing (optional). Leave blank for
# the recommended subdomain setup. If set, PUBLIC_BASE_URL above must also
# include the same path prefix.
# ROOT_PATH=/aiflow-api

#  Licensing
# demo or live; the operator's own assertion of intent, never itself an
# unlock, actual entitlements always derive from whether AIFLOW_LICENSE_KEY
# verifies.
AIFLOW_MODE=demo
# From the client's MeridFlow dashboard; verified offline, no phone home.
# Required for anything but the demo tier.
AIFLOW_LICENSE_KEY=

#  Gemini Live
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Vertex AI enterprise mode (alternative to GEMINI_API_KEY):
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

#  Twilio (optional, only needed for phone calls)
TWILIO_ACCOUNT_SID=
# Recommended by Twilio over using the Auth Token for outbound REST calls: a
# Standard API Key can be scoped and revoked independently of the account.
# Console: Account > API keys & auth tokens > Create API key > Standard.
# Leave both blank to fall back to TWILIO_AUTH_TOKEN below.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Always required, even if you set the API Key pair above: Twilio signs
# inbound webhook requests with the Auth Token specifically (never an API
# Key secret), so this is what verifies inbound calls are really from
# Twilio. Console: Account > API keys & auth tokens > Auth Token.
TWILIO_AUTH_TOKEN=

#  Widget
WIDGET_CORS_ORIGINS=["*"]

#  Admin dashboard CORS: unset (the default) reuses WIDGET_CORS_ORIGINS
#  above, today's behavior. Set this to your admin dashboard's real
#  origin(s) to stop the admin API from also accepting the widget's
#  permissive cross-origin policy, e.g.
#  ADMIN_CORS_ORIGINS=["https://admin.client-domain.com"]
ADMIN_CORS_ORIGINS=

#  SSRF protection: webhooks, custom tools, and Orchestrator remote
#  endpoints can't reach private/internal/cloud-metadata addresses by
#  default. List specific hostnames here if an agent legitimately needs to
#  reach one of your own internal systems, e.g. SSRF_ALLOWED_HOSTS=["crm.internal.example.com"]
SSRF_ALLOWED_HOSTS=[]

#  Outbound call queue
MAX_CONCURRENT_OUTBOUND_CALLS=5

#  Email (optional, only needed for the send_email tool / email triggers)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

#  Only needed for a Resend-inbound mailbox connection (an agent watching an
#  inbox via Resend's own receiving feature, an alternative to a polled
#  IMAP/SMTP mailbox). The signing secret from the Resend webhook pointed at
#  /api/v1/mailbox-webhooks/resend, subscribed to the email.received event.
RESEND_WEBHOOK_SECRET=

#  CRM/helpdesk connectors (optional, only needed to let an admin connect
#  Salesforce/HubSpot). Each pair is this deployment's own OAuth2 client
#  identity with that provider (a Salesforce Connected App or a HubSpot
#  app), not a customer's credential, one pair activates the connector for
#  every agent that connects to that provider.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

#  SSO (optional, only needed to let your team sign in via your identity
#  provider instead of an AiFlow-specific password). All five required
#  together once you turn this on.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The admin SPA's own public origin (a separate deployment from this
# backend), where the OIDC callback hands the finished login back to.
ADMIN_DASHBOARD_URL=

#  RAG / knowledge base search (optional, sensible defaults apply)
# EMBEDDING_MODEL=gemini-embedding-2
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5

#  Internal, no-one-reads-it-directly text generation: call summaries,
#  sentiment/outcome classification, eval grading (optional, sensible
#  default applies)
# SUMMARIZATION_MODEL=gemini-3.5-flash-lite

#  Text generation a real person actually reads or acts on unreviewed: a
#  headless agent task (e.g. a mailbox reply) or a delegated specialist's
#  answer (optional, sensible default applies)
# AGENT_TASK_MODEL=gemini-3.7-flash

#  The bare Gemini model a new Orchestrator gets when nobody picks one
#  explicitly (optional, sensible default applies)
# GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

#  Bounded retry for failed outbound dials (optional, default 0 = no retry)
# OUTBOUND_CALL_MAX_RETRIES=0
# MAX_CONCURRENT_OUTBOUND_CALLS=0

#  Session/token lifetimes (optional, sensible defaults apply)
# ADMIN_TOKEN_TTL_SECONDS=28800
# WIDGET_TOKEN_TTL_SECONDS=300

#  Observability (optional)
# SENTRY_DSN=

#  Rate limiting (optional; generous defaults apply automatically even if unset)
# WIDGET_SESSION_RATE_LIMIT=30/minute
# EVENT_INGESTION_RATE_LIMIT=120/minute
# LOGIN_RATE_LIMIT=10/minute

#  Data retention (optional, unset = keep forever, today's exact behavior)
# CALL_TRANSCRIPT_RETENTION_DAYS=
# EVENT_LOG_RETENTION_DAYS=
# OUTBOUND_MESSAGE_RETENTION_DAYS=

#  Postgres overlay (optional; only read if you use docker-compose.postgres.yml,
#  SQLite remains the default otherwise)
# POSTGRES_USER=aiflow
# POSTGRES_PASSWORD=aiflow
# POSTGRES_DB=aiflow

#  Image version pin (optional; only read by docker-compose.prod.yml,
#  docker-compose.caddy.yml, and docker-compose.coolify.yml, which pull
#  pre-built images, not by the app itself or the from-source docker-compose.yml)
# AIFLOW_VERSION=7

#  Orchestrators (optional, off by default)
# ORCHESTRATORS_ENABLED=false
# Only read for a "provider/model" Orchestrator model string, e.g. "anthropic/claude-sonnet-5"
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Step budget / timeout per Orchestrator run (defaults shown)
# ORCHESTRATOR_MAX_STEPS=25
# ORCHESTRATOR_TASK_TIMEOUT_SECONDS=60
# Most AiFlow-to-AiFlow delegation boundary crossings one federated task may
# make before it is refused (loop guard is always on; this only tunes the cap)
# FEDERATION_MAX_HOPS=3
